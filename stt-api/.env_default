# Gemini Speech-to-Text key. Obtain it from Google AI Studio.
GEMINI_API_KEY=

# ElevenLabs Speech-to-Text key. Obtain it from the ElevenLabs dashboard.
ELEVENLABS_API_KEY=

# Optional account-check endpoint override (origin, without /v1).
# ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io

# OpenRouter dedicated STT endpoint (this component reads its own .env).
OPENROUTER_API_KEY=
# Optional full API base:
# OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
