# Local overrides for lecture cleanup pipeline.
# Copy this file to config.yaml and edit. Do NOT edit config.default.yaml.
# Only include keys you want to override.

llm:
  provider: openai
  openai:
    model: gpt-5-mini

logging:
  level: info

